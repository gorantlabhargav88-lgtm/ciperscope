{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "web", "dev"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ciperscope/api", "dev"],
      "port": 3000,
      "url": "http://localhost:3000/health"
    },
    {
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@ciperscope/worker", "dev"],
      "port": 3001,
      "url": "http://localhost:3001/health"
    }
  ]
}
