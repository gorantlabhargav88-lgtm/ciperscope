# CiperScope Environment Configuration Example
# Copy this file to .env and fill in the secrets. DO NOT commit the .env file.

# ==========================================
# Core Infrastructure
# ==========================================
NODE_ENV=development
PORT=3000
WORKER_PORT=3001
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://user:password@localhost:5432/ciperscope_db?schema=public

# Redis (Cache and Queue)
REDIS_URL=redis://localhost:6379

# ==========================================
# Authentication & Security
# ==========================================
# Must be a secure 32+ character string in production
JWT_SECRET=
JWT_ISSUER=ciperscope-auth
JWT_AUDIENCE=ciperscope-web

# ==========================================
# Threat Intelligence Providers (CTI)
# ==========================================
# VirusTotal API Key for domains/hashes/files
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key for IPs
ABUSEIPDB_API_KEY=

# ==========================================
# Advanced Modules (Optional)
# ==========================================
# ML Service Configuration (if external)
# ML_API_ENDPOINT=

# Geolocation Service Configuration
# GEO_API_KEY=

# ==========================================
# Gmail Integration (Optional)
# ==========================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# GOOGLE_PUBSUB_TOPIC=
#
# Required whenever Gmail integration is enabled. Encrypts stored OAuth
# access/refresh tokens at rest (AES-256-GCM). Must be a random, high-entropy
# secret of at least 32 characters — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GMAIL_TOKEN_ENCRYPTION_KEY=
