# CiperScope Environment Configuration Example
# Copy this file to .env and fill in the secrets. DO NOT commit the .env file.

# Application
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://user:password@localhost:5432/ciperscope_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Configuration
# Must be a secure 256-bit+ secret in production
JWT_SECRET=
JWT_ISSUER=ciperscope-auth
JWT_AUDIENCE=ciperscope-web
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
