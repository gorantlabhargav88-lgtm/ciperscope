# CiperScope Environment Configuration Template
# Copy this file to .env and fill in the values. DO NOT commit the .env file.
#
# Classification of variables:
#   [REQUIRED]            - Necessary for core platform operation
#   [OPTIONAL]            - Enables extended integration features (CTI, GeoIP, Gmail, ML, Blockchain, SMTP, S3)
#   [PRODUCTION ONLY]     - Strict production requirements (e.g. 32+ char keys, HTTPS URLs)
#   [DEVELOPMENT DEFAULTS]- Sensible local fallbacks provided

# ==========================================
# 1. Core Server & Networking [REQUIRED]
# ==========================================
NODE_ENV=development
PORT=3000
WORKER_PORT=3001
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# ==========================================
# 2. Database & Caching [REQUIRED]
# ==========================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://user:password@localhost:5432/ciperscope_db?schema=public

# Redis connection string for BullMQ queue processing and caching
REDIS_URL=redis://localhost:6379

# ==========================================
# 3. Authentication & Security [REQUIRED]
# ==========================================
# High-entropy secret of at least 32 characters for signing HS256 JWTs
JWT_SECRET=your_minimum_32_character_jwt_secret_here
JWT_ISSUER=ciperscope-auth
JWT_AUDIENCE=ciperscope-web

# ==========================================
# 4. Storage Configuration [OPTIONAL]
# ==========================================
# Default: Local storage in .data/emails or RAW_EMAIL_STORAGE_PATH
# RAW_EMAIL_STORAGE_PATH=/app/data/emails
# S3 / MinIO Object Storage (Optional override):
# S3_BUCKET=ciperscope-raw-emails
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com

# ==========================================
# 5. Threat Intelligence (CTI) & Geolocation [OPTIONAL]
# ==========================================
# VirusTotal API Key for IOC hashing & reputation
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key for IP reputation evaluation
ABUSEIPDB_API_KEY=

# MaxMind GeoIP2 City Web Service (HTTP + Basic Auth)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# RDAP Domain Intelligence (defaults to true; set to false to disable external lookups)
RDAP_ENABLED=true

# ==========================================
# 6. ML Inference Service (DistilBERT) [OPTIONAL]
# ==========================================
# URL and Bearer token for the Python FastAPI ML microservice
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=your_ml_service_bearer_token

# ==========================================
# 7. Gmail Ingestion & OAuth Integration [OPTIONAL]
# ==========================================
# Google Cloud Platform OAuth 2.0 Web Client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/gmail/callback
GOOGLE_PUBSUB_TOPIC=projects/your-gcp-project/topics/ciperscope-gmail-watch

# Required when Gmail is used: 32+ character key for AES-256-GCM token encryption
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_TOKEN_ENCRYPTION_KEY=

# ==========================================
# 8. Blockchain Evidence Anchoring [OPTIONAL]
# ==========================================
# Enables EVM-based Merkle root anchoring to public testnets
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_NETWORK=sepolia
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
BLOCKCHAIN_CONTRACT_ADDRESS=
# Private key for funded gas wallet (DO NOT commit)
BLOCKCHAIN_PRIVATE_KEY=

# ==========================================
# 9. SMTP Email Notifications & Invites [OPTIONAL]
# ==========================================
# SMTP settings for organization invitation delivery
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=security@yourdomain.com
# SMTP_SECURE=false
