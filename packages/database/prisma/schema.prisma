generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String               @id @default(uuid())
  name         String
  domain       String?              @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  APIKey       APIKey[]
  alerts       Alert[]
  auditLogs    AuditLog[]
  cases        Case[]
  caseNotes    CaseNote[]
  emails       Email[]
  integrations Integration[]
  mlInferences MLInference[]
  members      OrganizationMember[]
  Role         Role[]
  systemConfig SystemSetting[]
}

model User {
  id            String                @id @default(uuid())
  email         String                @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  isActive      Boolean               @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  assignedCases Case[]                @relation("CaseAssignee")
  createdCases  Case[]                @relation("CaseCreator")
  caseNotes     CaseNote[]
  custodyEvents ChainOfCustodyEvent[]
  memberships   OrganizationMember[]
  sessions      Session[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id             String               @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  members        OrganizationMember[]
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]

  @@unique([organizationId, name])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id            String         @id @default(uuid())
  userId        String
  deviceId      String?
  ipAddress     String?
  userAgent     String?
  isValid       Boolean        @default(true)
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  revokedAt     DateTime?
  refreshTokens RefreshToken[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  sessionId String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model APIKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  prefix         String
  hash           String       @unique
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  isRevoked      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  provider       String
  // accessToken/refreshToken hold an AES-256-GCM encrypted envelope
  // ("v1:<ivHex>:<authTagHex>:<ciphertextHex>" — see
  // packages/config/src/tokenCrypto.ts), never plaintext. Column type is
  // unchanged (String) since the envelope is itself a string.
  accessToken    String
  refreshToken   String
  emailAddress   String
  historyId      String?
  // ACTIVE | ERROR | DISCONNECTED — set to ERROR by the sync worker when
  // Google permanently rejects the stored refresh token (e.g. revoked at
  // Google's end), and to DISCONNECTED by the disconnect endpoint.
  status         String       @default("ACTIVE")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, emailAddress])
  // A given mailbox can only ever be connected to ONE organization at a
  // time. This is what makes the Gmail webhook lookup (which Google's own
  // push-notification payload identifies only by emailAddress, never by
  // organizationId — a real external protocol constraint, not a choice we
  // can change) safe: findUnique on this key can never return an
  // ambiguous cross-tenant match. Enforced at the database level, not just
  // in application code.
  @@unique([provider, emailAddress])
}

model Case {
  id             String          @id @default(uuid())
  organizationId String
  title          String
  description    String?
  severity       Priority        @default(LOW)
  priority       Priority        @default(LOW)
  status         CaseStatus      @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignedUserId String?
  creatorId      String?
  resolvedAt     DateTime?
  alerts         Alert[]
  assignedUser   User?           @relation("CaseAssignee", fields: [assignedUserId], references: [id])
  creator        User?           @relation("CaseCreator", fields: [creatorId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notes          CaseNote[]
  emails         Email[]         @relation("CaseEmails")
  evidence       Evidence[]
  investigations Investigation[]
  reports        Report[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([status, priority])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, createdAt])
}

model Investigation {
  id          String              @id @default(uuid())
  caseId      String
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  case        Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  notes       InvestigationNote[]
}

model InvestigationNote {
  id              String        @id @default(uuid())
  investigationId String
  content         String
  authorId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
}

model CaseNote {
  id             String       @id @default(uuid())
  organizationId String
  caseId         String
  authorId       String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  author         User         @relation(fields: [authorId], references: [id])
  case           Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, caseId])
  @@index([organizationId, authorId])
}

model Email {
  id                String                       @id @default(uuid())
  messageId         String?
  subject           String?
  senderAddress     String?
  replyTo           String?
  returnPath        String?
  date              DateTime?
  ingestionSrc      String                       @default("UPLOAD")
  rawStorageKey     String?
  classification    EmailClassification          @default(UNKNOWN)
  riskScore         Float?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  organizationId    String
  sha256            String
  analysisStatus    AnalysisState                @default(PENDING)
  caseId            String?
  campaigns         CampaignEmail[]
  dkimVerifications DkimVerification[]
  dmarcVerification DmarcVerification?
  dnsObservations   DnsObservation[]
  case              Case?                        @relation("CaseEmails", fields: [caseId], references: [id])
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses         EmailAddress[]
  attachments       EmailAttachment[]
  authAnalysis      EmailAuthenticationAnalysis?
  headers           EmailHeader[]
  urls              EmailUrl[]
  inferences        MLInference[]
  mimeParts         MimePart[]
  relayHops         RelayHop[]
  riskAssessments   RiskAssessment[]
  spfVerifications  SpfVerification[]

  @@unique([organizationId, sha256])
  @@index([organizationId])
  @@index([messageId])
  @@index([senderAddress])
  @@index([caseId])
}

model EmailHeader {
  id        String   @id @default(uuid())
  emailId   String
  name      String
  value     String
  createdAt DateTime @default(now())
  index     Int      @default(0)
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model RelayHop {
  id               String    @id @default(uuid())
  emailId          String
  hopOrder         Int
  sourceIp         String?
  hostname         String?
  timestamp        DateTime?
  receivedHeader   String
  createdAt        DateTime  @default(now())
  byHost           String?
  fromHost         String?
  parsedConfidence Float?
  protocol         String?
  receivingHost    String?
  sendingHost      String?
  email            Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailAttachment {
  id              String   @id @default(uuid())
  emailId         String
  filename        String
  mimeType        String
  sizeBytes       Int
  sha256          String?
  storageKey      String?
  createdAt       DateTime @default(now())
  actualMimeType  String?
  archiveMetadata Json?
  isArchive       Boolean  @default(false)
  isMismatch      Boolean  @default(false)
  magicBytes      String?
  email           Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailUrl {
  id            String              @id @default(uuid())
  emailId       String
  url           String
  domain        String?
  createdAt     DateTime            @default(now())
  indicators    Json?
  isObfuscated  Boolean             @default(false)
  normalizedUrl String?
  source        UrlExtractionSource @default(TEXT)
  email         Email               @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model MimePart {
  id                 String     @id @default(uuid())
  emailId            String
  parentId           String?
  partIndex          String
  contentType        String
  contentDisposition String?
  filename           String?
  contentId          String?
  contentLocation    String?
  transferEncoding   String?
  charset            String?
  sizeBytes          Int?
  isAttachment       Boolean    @default(false)
  createdAt          DateTime   @default(now())
  email              Email      @relation(fields: [emailId], references: [id], onDelete: Cascade)
  parent             MimePart?  @relation("MimePartHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           MimePart[] @relation("MimePartHierarchy")

  @@index([emailId])
}

model EmailAddress {
  id          String   @id @default(uuid())
  emailId     String
  headerName  String
  displayName String?
  address     String?
  localPart   String?
  domain      String?
  raw         String
  createdAt   DateTime @default(now())
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailAuthenticationAnalysis {
  id           String           @id @default(uuid())
  emailId      String           @unique
  spf          AuthResultStatus @default(NONE)
  dkim         AuthResultStatus @default(NONE)
  dmarc        AuthResultStatus @default(NONE)
  isConsistent Boolean          @default(false)
  summary      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  email        Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model SpfVerification {
  id               String           @id @default(uuid())
  emailId          String
  result           AuthResultStatus @default(NONE)
  domain           String?
  evaluatedIp      String?
  matchedMechanism String?
  explanation      String?
  lookups          Int              @default(0)
  createdAt        DateTime         @default(now())
  email            Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model DkimVerification {
  id             String           @id @default(uuid())
  emailId        String
  result         AuthResultStatus @default(NONE)
  domain         String?
  selector       String?
  algorithm      String?
  bodyHashResult AuthResultStatus @default(NONE)
  explanation    String?
  createdAt      DateTime         @default(now())
  email          Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model DmarcVerification {
  id              String           @id @default(uuid())
  emailId         String           @unique
  result          AuthResultStatus @default(NONE)
  orgDomain       String?
  policy          String?
  subdomainPolicy String?
  spfAlignment    String?
  dkimAlignment   String?
  explanation     String?
  createdAt       DateTime         @default(now())
  email           Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model DnsObservation {
  id         String   @id @default(uuid())
  emailId    String
  queryName  String
  recordType String
  response   String?
  rcode      String?
  durationMs Int?
  createdAt  DateTime @default(now())
  email      Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model Indicator {
  id           String                   @id @default(uuid())
  type         IndicatorType
  value        String                   @unique
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  campaigns    CampaignIndicator[]
  observations ThreatIntelObservation[]

  @@index([type, value])
}

model ThreatIntelObservation {
  id              String        @id @default(uuid())
  indicatorId     String
  provider        String
  verdict         ThreatVerdict
  confidence      Float?
  rawResponse     Json?
  observationTime DateTime      @default(now())
  indicator       Indicator     @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([indicatorId])
  @@index([provider])
}

model GeoLocation {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  country   String?
  region    String?
  city      String?
  latitude  Float?
  longitude Float?
  asn       String?
  isp       String?
  provider  String   @default("MaxMind")
  updatedAt DateTime @updatedAt
}

model MLInference {
  id                   String       @id @default(uuid())
  emailId              String
  prediction           String?
  processingTimeMs     Int?
  explanation          String?
  createdAt            DateTime     @default(now())
  artifactSha256       String?
  labelMappingVersion  String?
  modelName            String?
  modelScore           Float?
  modelVersion         String?
  organizationId       String
  preprocessingVersion String?
  serviceVersion       String?
  status               String       @default("NOT_AVAILABLE")
  tokenizerVersion     String?
  email                Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([emailId])
}

model RiskAssessment {
  id           String       @id @default(uuid())
  emailId      String
  overallScore Float
  riskLevel    Priority
  version      String
  createdAt    DateTime     @default(now())
  email        Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)
  factors      RiskFactor[]

  @@unique([emailId, version])
  @@index([emailId])
}

model RiskFactor {
  id                String         @id @default(uuid())
  riskAssessmentId  String
  category          String
  description       String
  scoreContribution Float
  createdAt         DateTime       @default(now())
  riskAssessment    RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
}

model Campaign {
  id          String              @id @default(uuid())
  name        String
  description String?
  firstSeen   DateTime
  lastSeen    DateTime
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  emails      CampaignEmail[]
  indicators  CampaignIndicator[]
}

model CampaignIndicator {
  campaignId  String
  indicatorId String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@id([campaignId, indicatorId])
}

model CampaignEmail {
  campaignId String
  emailId    String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@id([campaignId, emailId])
}

model Evidence {
  id               String                @id @default(uuid())
  caseId           String
  type             EvidenceType
  storageKey       String
  filename         String?
  mimeType         String?
  sizeBytes        Int?
  sha256           String                @unique
  status           EvidenceStatus        @default(ACTIVE)
  collectionTime   DateTime              @default(now())
  collectedById    String?
  blockchainAnchor BlockchainAnchor?
  custodyEvents    ChainOfCustodyEvent[]
  case             Case                  @relation(fields: [caseId], references: [id])

  @@index([caseId])
}

model ChainOfCustodyEvent {
  id              String               @id @default(uuid())
  evidenceId      String
  action          CustodyAction
  actorId         String?
  description     String?
  previousEventId String?              @unique
  timestamp       DateTime             @default(now())
  actor           User?                @relation(fields: [actorId], references: [id])
  evidence        Evidence             @relation(fields: [evidenceId], references: [id])
  previous        ChainOfCustodyEvent? @relation("CustodyChain", fields: [previousEventId], references: [id], onDelete: Restrict)
  next            ChainOfCustodyEvent? @relation("CustodyChain")

  @@index([evidenceId])
}

model BlockchainAnchor {
  id              String                 @id @default(uuid())
  evidenceId      String                 @unique
  network         String                 @default("HyperledgerFabric")
  transactionId   String?                @unique
  blockNumber     Int?
  status          BlockchainAnchorStatus @default(PENDING)
  errorDetails    String?
  anchorTimestamp DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  evidence        Evidence               @relation(fields: [evidenceId], references: [id])

  @@index([status])
}

model Alert {
  id             String        @id @default(uuid())
  organizationId String
  caseId         String?
  title          String
  message        String
  severity       AlertSeverity @default(INFO)
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  case           Case?         @relation(fields: [caseId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isRead])
}

model Report {
  id            String   @id @default(uuid())
  caseId        String
  title         String
  contentHtml   String?
  storageKey    String?
  generatedById String?
  createdAt     DateTime @default(now())
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  resource       String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  status         String        @default("SUCCESS")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
}

model SystemSetting {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  value          String
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model IdempotencyOperation {
  id              String                     @id @default(uuid())
  organizationId  String
  operationKey    String
  operationType   String
  resourceId      String?
  status          IdempotencyOperationStatus @default(PENDING)
  resultReference String?
  errorCode       String?
  errorMessage    String?
  attemptCount    Int                        @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  completedAt     DateTime?

  @@unique([organizationId, operationKey, resourceId])
  @@index([organizationId, operationKey])
}

enum CaseStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmailClassification {
  UNKNOWN
  LEGITIMATE
  SUSPICIOUS
  PHISHING
  IMPERSONATION
  BEC
  FRAUD
  MALWARE
}

enum AuthResultStatus {
  PASS
  FAIL
  SOFTFAIL
  NEUTRAL
  NONE
  TEMPERROR
  PERMERROR
}

enum IndicatorType {
  IP
  DOMAIN
  URL
  HASH
  EMAIL_ADDRESS
  ASN
}

enum ThreatVerdict {
  CLEAN
  SUSPICIOUS
  MALICIOUS
  UNKNOWN
}

enum EvidenceType {
  RAW_EMAIL
  HEADER
  ATTACHMENT
  URL
  IP
  DOMAIN
  SCREENSHOT
  REPORT
  LOG
  OTHER
}

enum EvidenceStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum CustodyAction {
  COLLECTED
  UPLOADED
  HASHED
  ANALYZED
  EXPORTED
  VERIFIED
  BLOCKCHAIN_ANCHORED
  ACCESSED
}

enum BlockchainAnchorStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
  VERIFICATION_FAILED
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnalysisState {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum UrlExtractionSource {
  TEXT
  HTML_HREF
  HTML_SRC
  HTML_ACTION
  OTHER
}

enum IdempotencyOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  RECONCILIATION_REQUIRED
}
