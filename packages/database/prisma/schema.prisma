datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS
// ============================================================================

enum CaseStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EmailClassification {
  UNKNOWN
  LEGITIMATE
  SUSPICIOUS
  PHISHING
  IMPERSONATION
  BEC
  FRAUD
  MALWARE
}

enum AuthResultStatus {
  PASS
  FAIL
  SOFTFAIL
  NEUTRAL
  NONE
  TEMPERROR
  PERMERROR
}

enum IndicatorType {
  IP
  DOMAIN
  URL
  HASH
  EMAIL_ADDRESS
  ASN
}

enum ThreatVerdict {
  CLEAN
  SUSPICIOUS
  MALICIOUS
  UNKNOWN
}

enum EvidenceType {
  RAW_EMAIL
  HEADER
  ATTACHMENT
  URL
  IP
  DOMAIN
  SCREENSHOT
  REPORT
  LOG
  OTHER
}

enum EvidenceStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum CustodyAction {
  COLLECTED
  UPLOADED
  HASHED
  ANALYZED
  EXPORTED
  VERIFIED
  BLOCKCHAIN_ANCHORED
  ACCESSED
}

enum BlockchainAnchorStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
  VERIFICATION_FAILED
}

enum AlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnalysisState {
  PENDING
  PROCESSING
  COMPLETED
  PARTIAL
  FAILED
}

enum UrlExtractionSource {
  TEXT
  HTML_HREF
  HTML_SRC
  HTML_ACTION
  OTHER
}

// ============================================================================
// IDENTITY / ACCESS
// ============================================================================

model Organization {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  cases        Case[]
  emails       Email[]
  auditLogs    AuditLog[]
  alerts       Alert[]
  systemConfig SystemSetting[]
  Role         Role[]
  APIKey       APIKey[]
  mlInferences MLInference[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  memberships   OrganizationMember[]
  sessions      Session[]
  custodyEvents ChainOfCustodyEvent[]
}

model OrganizationMember {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id             String   @id @default(uuid())
  organizationId String? // Null means system-wide default role
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  members      OrganizationMember[]

  @@unique([organizationId, name])
}

model Permission {
  id          String   @id @default(uuid())
  action      String // e.g., "evidence.verify", "case.read"
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  deviceId  String?
  ipAddress String?
  userAgent String?
  isValid   Boolean   @default(true)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  sessionId String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  type      String // "EMAIL_VERIFY" or "PASSWORD_RESET"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model APIKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  prefix         String // First few chars to show in UI
  hash           String    @unique
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  isRevoked      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ============================================================================
// CASE MANAGEMENT
// ============================================================================

model Case {
  id             String     @id @default(uuid())
  organizationId String
  title          String
  description    String?    @db.Text
  severity       Priority   @default(LOW)
  priority       Priority   @default(LOW)
  status         CaseStatus @default(OPEN)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  emails         Email[]
  evidence       Evidence[]
  reports        Report[]
  alerts         Alert[]
  investigations Investigation[]

  @@index([organizationId])
  @@index([status, priority])
}

model Investigation {
  id          String   @id @default(uuid())
  caseId      String
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  case  Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  notes InvestigationNote[]
}

model InvestigationNote {
  id              String   @id @default(uuid())
  investigationId String
  content         String   @db.Text
  authorId        String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// EMAIL FORENSICS
// ============================================================================

model Email {
  id             String              @id @default(uuid())
  organizationId String
  caseId         String?
  messageId      String?
  subject        String?             @db.Text
  senderAddress  String?
  replyTo        String?
  returnPath     String?
  date           DateTime?
  ingestionSrc   String              @default("UPLOAD") // UPLOAD, GMAIL_API, etc.
  rawStorageKey  String? // Path in object storage
  sha256         String              // Added for deduplication
  classification EmailClassification @default(UNKNOWN)
  analysisStatus AnalysisState       @default(PENDING)
  riskScore      Float?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  case            Case?                 @relation(fields: [caseId], references: [id], onDelete: SetNull)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  headers         EmailHeader[]
  addresses       EmailAddress[]
  relayHops       RelayHop[]
  mimeParts       MimePart[]
  attachments     EmailAttachment[]
  urls            EmailUrl[]
  authAnalysis    EmailAuthenticationAnalysis?
  spfVerifications SpfVerification[]
  dkimVerifications DkimVerification[]
  dmarcVerification DmarcVerification?
  dnsObservations DnsObservation[]
  inferences      MLInference[]
  riskAssessments RiskAssessment[]
  campaigns       CampaignEmail[]

  @@unique([organizationId, sha256])
  @@index([organizationId])
  @@index([messageId])
  @@index([senderAddress])
  @@index([caseId])
}

model EmailHeader {
  id        String   @id @default(uuid())
  emailId   String
  name      String
  value     String   @db.Text
  index     Int      @default(0) // Preserves original header order
  createdAt DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model RelayHop {
  id             String    @id @default(uuid())
  emailId        String
  hopOrder       Int

  // Extracted fields
  receivingHost  String?
  sendingHost    String?
  fromHost       String?
  byHost         String?
  protocol       String?
  parsedConfidence Float?

  sourceIp       String?
  hostname       String?
  timestamp      DateTime?
  receivedHeader String    @db.Text
  createdAt      DateTime  @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailAttachment {
  id         String   @id @default(uuid())
  emailId    String
  filename   String
  mimeType   String
  sizeBytes  Int
  sha256     String?
  storageKey String?

  // Phase 10 Threat Analysis fields
  actualMimeType String?
  isMismatch     Boolean  @default(false)
  magicBytes     String?
  isArchive      Boolean  @default(false)
  archiveMetadata Json?

  createdAt  DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model EmailUrl {
  id        String   @id @default(uuid())
  emailId   String
  url       String   @db.Text
  domain    String?

  // Phase 10 Threat Analysis fields
  normalizedUrl String? @db.Text
  isObfuscated  Boolean @default(false)
  indicators    Json?
  source        UrlExtractionSource @default(TEXT)

  createdAt DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model MimePart {
  id                 String   @id @default(uuid())
  emailId            String
  parentId           String?
  partIndex          String   // e.g. "1", "1.1", "2"
  contentType        String
  contentDisposition String?
  filename           String?
  contentId          String?
  contentLocation    String?
  transferEncoding   String?
  charset            String?
  sizeBytes          Int?
  isAttachment       Boolean  @default(false)
  createdAt          DateTime @default(now())

  email    Email      @relation(fields: [emailId], references: [id], onDelete: Cascade)
  parent   MimePart?  @relation("MimePartHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children MimePart[] @relation("MimePartHierarchy")

  @@index([emailId])
}

model EmailAddress {
  id          String   @id @default(uuid())
  emailId     String
  headerName  String   // e.g. "From", "To", "Cc"
  displayName String?
  address     String?  // Normalized email address
  localPart   String?
  domain      String?
  raw         String   @db.Text // Original unparsed value
  createdAt   DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

// ============================================================================
// AUTHENTICATION RESULTS
// ============================================================================

model EmailAuthenticationAnalysis {
  id        String           @id @default(uuid())
  emailId   String           @unique

  spf       AuthResultStatus @default(NONE)
  dkim      AuthResultStatus @default(NONE)
  dmarc     AuthResultStatus @default(NONE)

  isConsistent Boolean       @default(false)
  summary      String?       @db.Text

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model SpfVerification {
  id              String           @id @default(uuid())
  emailId         String
  result          AuthResultStatus @default(NONE)
  domain          String?
  evaluatedIp     String?
  matchedMechanism String?
  explanation     String?          @db.Text
  lookups         Int              @default(0)
  createdAt       DateTime         @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model DkimVerification {
  id            String           @id @default(uuid())
  emailId       String
  result        AuthResultStatus @default(NONE)
  domain        String?
  selector      String?
  algorithm     String?
  bodyHashResult AuthResultStatus @default(NONE)
  explanation   String?          @db.Text
  createdAt     DateTime         @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model DmarcVerification {
  id             String           @id @default(uuid())
  emailId        String           @unique
  result         AuthResultStatus @default(NONE)
  orgDomain      String?
  policy         String?          // p=
  subdomainPolicy String?         // sp=
  spfAlignment   String?          // strict, relaxed, unaligned
  dkimAlignment  String?          // strict, relaxed, unaligned
  explanation    String?          @db.Text
  createdAt      DateTime         @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model DnsObservation {
  id         String   @id @default(uuid())
  emailId    String
  queryName  String
  recordType String   // TXT, MX, A, AAAA
  response   String?  @db.Text
  rcode      String?  // NOERROR, NXDOMAIN, SERVFAIL, TIMEOUT
  durationMs Int?
  createdAt  DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

// ============================================================================
// INDICATORS & THREAT INTELLIGENCE
// ============================================================================

model Indicator {
  id        String        @id @default(uuid())
  type      IndicatorType
  value     String        @unique @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  observations ThreatIntelObservation[]
  campaigns    CampaignIndicator[]

  @@index([type, value])
}

model ThreatIntelObservation {
  id              String        @id @default(uuid())
  indicatorId     String
  provider        String // e.g., "VirusTotal", "PhishTank"
  verdict         ThreatVerdict
  confidence      Float?
  rawResponse     Json?
  observationTime DateTime      @default(now())

  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([indicatorId])
  @@index([provider])
}

// ============================================================================
// NETWORK & GEOLOCATION
// ============================================================================

model GeoLocation {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  country   String?
  region    String?
  city      String?
  latitude  Float?
  longitude Float?
  asn       String?
  isp       String?
  provider  String   @default("MaxMind")
  updatedAt DateTime @updatedAt
}

// ============================================================================
// AI & RISK ENGINE
// ============================================================================

model MLInference {
  id                   String   @id @default(uuid())
  organizationId       String
  emailId              String
  status               String   @default("NOT_AVAILABLE") // MODEL_PREDICTION, FAILED, TIMEOUT, NOT_AVAILABLE, INSUFFICIENT_CONFIDENCE
  prediction           String?  // e.g., "BEC", "PHISHING"
  modelScore           Float?
  modelName            String?
  modelVersion         String?
  artifactSha256       String?
  tokenizerVersion     String?
  preprocessingVersion String?
  labelMappingVersion  String?
  serviceVersion       String?
  processingTimeMs     Int?
  explanation          String?  @db.Text
  createdAt            DateTime @default(now()) // inference timestamp

  email        Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([emailId])
}

model RiskAssessment {
  id           String   @id @default(uuid())
  emailId      String
  overallScore Float // 0-100
  riskLevel    Priority
  version      String // Scoring engine version
  createdAt    DateTime @default(now())

  email   Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)
  factors RiskFactor[]

  @@index([emailId])
}

model RiskFactor {
  id                String   @id @default(uuid())
  riskAssessmentId  String
  category          String // e.g., "AUTH_FAILURE", "MALICIOUS_URL"
  description       String   @db.Text
  scoreContribution Float
  createdAt         DateTime @default(now())

  riskAssessment RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
}

// ============================================================================
// GRAPH / CAMPAIGN
// ============================================================================

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  firstSeen   DateTime
  lastSeen    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  indicators CampaignIndicator[]
  emails     CampaignEmail[]
}

model CampaignIndicator {
  campaignId  String
  indicatorId String

  campaign  Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  indicator Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@id([campaignId, indicatorId])
}

model CampaignEmail {
  campaignId String
  emailId    String

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email    Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@id([campaignId, emailId])
}

// ============================================================================
// EVIDENCE / FORENSICS & BLOCKCHAIN
// ============================================================================

model Evidence {
  id             String         @id @default(uuid())
  caseId         String
  type           EvidenceType
  storageKey     String // Path to the actual evidence object
  filename       String?
  mimeType       String?
  sizeBytes      Int?
  sha256         String         @unique // Cryptographic fingerprint
  status         EvidenceStatus @default(ACTIVE)
  collectionTime DateTime       @default(now())
  collectedById  String?

  case             Case                  @relation(fields: [caseId], references: [id], onDelete: Restrict)
  custodyEvents    ChainOfCustodyEvent[]
  blockchainAnchor BlockchainAnchor?

  @@index([caseId])
}

model ChainOfCustodyEvent {
  id              String        @id @default(uuid())
  evidenceId      String
  action          CustodyAction
  actorId         String? // ID of the User who performed the action
  description     String?       @db.Text
  previousEventId String?       @unique
  timestamp       DateTime      @default(now())

  evidence Evidence             @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  actor    User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)
  previous ChainOfCustodyEvent? @relation("CustodyChain", fields: [previousEventId], references: [id], onDelete: Restrict)
  next     ChainOfCustodyEvent? @relation("CustodyChain")

  @@index([evidenceId])
}

model BlockchainAnchor {
  id              String                 @id @default(uuid())
  evidenceId      String                 @unique
  network         String                 @default("HyperledgerFabric")
  transactionId   String?                @unique
  blockNumber     Int?
  status          BlockchainAnchorStatus @default(PENDING)
  errorDetails    String?                @db.Text
  anchorTimestamp DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@index([status])
}

// ============================================================================
// ALERTING & REPORTING
// ============================================================================

model Alert {
  id             String        @id @default(uuid())
  organizationId String
  caseId         String?
  title          String
  message        String        @db.Text
  severity       AlertSeverity @default(INFO)
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  case         Case?        @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([organizationId, isRead])
}

model Report {
  id            String   @id @default(uuid())
  caseId        String
  title         String
  contentHtml   String?  @db.Text
  storageKey    String?
  generatedById String?
  createdAt     DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ============================================================================
// AUDITING
// ============================================================================

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  resource       String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([createdAt])
}

model SystemSetting {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  value          String   @db.Text
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

// ============================================================================
// IDEMPOTENCY
// ============================================================================

enum IdempotencyOperationStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  RECONCILIATION_REQUIRED
}

model IdempotencyOperation {
  id              String                     @id @default(uuid())
  organizationId  String
  operationKey    String
  operationType   String
  resourceId      String?
  status          IdempotencyOperationStatus @default(PENDING)
  resultReference String?                    @db.Text
  errorCode       String?
  errorMessage    String?                    @db.Text
  attemptCount    Int                        @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  completedAt     DateTime?

  @@unique([organizationId, operationKey, resourceId])
  @@index([organizationId, operationKey])
}
