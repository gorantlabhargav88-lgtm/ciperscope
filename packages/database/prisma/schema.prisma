generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "linux-musl-openssl-3.0.x" is needed for the
  // node:20-alpine Docker runtime images (services/api/Dockerfile,
  // services/worker/Dockerfile) — that Alpine version ships OpenSSL 3.x
  // only (no libssl.so.1.1 compat package available), so the default
  // musl engine binary (linked against OpenSSL 1.1) fails to load at
  // container startup with "Error loading shared library libssl.so.1.1".
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String               @id @default(uuid())
  name         String
  domain       String?              @unique
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  APIKey       APIKey[]
  alerts       Alert[]
  auditLogs    AuditLog[]
  cases        Case[]
  caseNotes    CaseNote[]
  emails       Email[]
  integrations Integration[]
  mlInferences MLInference[]
  members      OrganizationMember[]
  Role         Role[]
  systemConfig SystemSetting[]
  webhooks     Webhook[]
  invitations  Invitation[]
  emailOutbox  EmailDispatchOutbox[]
}

model User {
  id              String                @id @default(uuid())
  email           String                @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  isActive        Boolean               @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  assignedCases   Case[]                @relation("CaseAssignee")
  createdCases    Case[]                @relation("CaseCreator")
  caseNotes       CaseNote[]
  custodyEvents   ChainOfCustodyEvent[]
  memberships     OrganizationMember[]
  sessions        Session[]
  sentInvitations Invitation[]          @relation("InvitationInviter")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Role {
  id             String               @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  isSystem       Boolean              @default(false)
  createdAt      DateTime             @default(now())
  members        OrganizationMember[]
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  invitations    Invitation[]

  @@unique([organizationId, name])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Organization member invitations (Phase 3 — no SMTP/email provider exists
// anywhere in this repository, confirmed by inspection: the invited person
// is given a URL out of band — see services/api/src/modules/invitation/
// invitation.routes.ts for the dev-only-URL-exposure gate). Deliberately a
// new model: nothing else in the schema represents a not-yet-accepted,
// expiring, single-use, role-constrained grant of org access.
//
// tokenHash is SHA-256 (not argon2 like User.passwordHash/RefreshToken.
// tokenHash) — this token is a full-entropy random value the invitee never
// chooses, not a low-entropy secret an attacker could offline-guess, so a
// slow password-hash function buys nothing and would force enumerating
// every pending invitation per lookup instead of a direct indexed query.
enum InvitationEmailStatus {
  // No SMTP provider configured (packages/providers/src/email) — the
  // invitation is still fully real and acceptable; only email delivery
  // itself did not happen. Never presented as an error to the admin.
  NOT_CONFIGURED
  SENT
  FAILED
}

model Invitation {
  id             String                @id @default(uuid())
  organizationId String
  email          String
  roleId         String
  tokenHash      String                @unique
  status         InvitationStatus      @default(PENDING)
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime              @default(now())
  // Delivery status of the invitation EMAIL — deliberately separate from
  // `status` (the invitation's own lifecycle: PENDING/ACCEPTED/EXPIRED/
  // REVOKED). An email can fail to send while the invitation itself
  // remains perfectly valid and acceptable via its link, so these two
  // states must never be conflated into one field.
  emailStatus    InvitationEmailStatus @default(NOT_CONFIGURED)
  // Safe, human-readable failure reason only (e.g. an SMTP response
  // message) — never the SMTP transporter config, which holds the
  // password. See packages/providers/src/email's SmtpEmailProvider.
  emailError     String?
  // Supersession chain: when an invitation is resent, the OLD row is
  // marked REVOKED and a NEW row is created (never reusing the old
  // token) — this points the new row back at what it replaced, purely
  // for admin-facing history/audit, not consulted by any auth check.
  supersedesId   String?               @unique
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role                  @relation(fields: [roleId], references: [id])
  invitedBy      User?                 @relation("InvitationInviter", fields: [invitedById], references: [id])
  supersedes     Invitation?           @relation("InvitationSupersession", fields: [supersedesId], references: [id])
  supersededBy   Invitation?           @relation("InvitationSupersession")

  @@index([organizationId])
  @@index([email])
  @@index([status, expiresAt])
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id            String         @id @default(uuid())
  userId        String
  deviceId      String?
  ipAddress     String?
  userAgent     String?
  isValid       Boolean        @default(true)
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  revokedAt     DateTime?
  refreshTokens RefreshToken[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(uuid())
  sessionId String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

model APIKey {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  prefix         String
  hash           String       @unique
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  isRevoked      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Integration {
  id             String       @id @default(uuid())
  organizationId String
  provider       String
  // accessToken/refreshToken hold an AES-256-GCM encrypted envelope
  // ("v1:<ivHex>:<authTagHex>:<ciphertextHex>" — see
  // packages/config/src/tokenCrypto.ts), never plaintext. Column type is
  // unchanged (String) since the envelope is itself a string.
  accessToken    String
  refreshToken   String
  emailAddress   String
  historyId      String?
  // ACTIVE | ERROR | DISCONNECTED — set to ERROR by the sync worker when
  // Google permanently rejects the stored refresh token (e.g. revoked at
  // Google's end), and to DISCONNECTED by the disconnect endpoint.
  status         String       @default("ACTIVE")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, emailAddress])
  // A given mailbox can only ever be connected to ONE organization at a
  // time. This is what makes the Gmail webhook lookup (which Google's own
  // push-notification payload identifies only by emailAddress, never by
  // organizationId — a real external protocol constraint, not a choice we
  // can change) safe: findUnique on this key can never return an
  // ambiguous cross-tenant match. Enforced at the database level, not just
  // in application code.
  @@unique([provider, emailAddress])
}

model Case {
  id             String          @id @default(uuid())
  organizationId String
  title          String
  description    String?
  severity       Priority        @default(LOW)
  priority       Priority        @default(LOW)
  status         CaseStatus      @default(OPEN)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  assignedUserId String?
  creatorId      String?
  resolvedAt     DateTime?
  alerts         Alert[]
  assignedUser   User?           @relation("CaseAssignee", fields: [assignedUserId], references: [id])
  creator        User?           @relation("CaseCreator", fields: [creatorId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notes          CaseNote[]
  emails         Email[]         @relation("CaseEmails")
  evidence       Evidence[]
  investigations Investigation[]
  reports        Report[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([status, priority])
  @@index([organizationId, assignedUserId])
  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, createdAt])
}

model Investigation {
  id          String              @id @default(uuid())
  caseId      String
  title       String
  description String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  case        Case                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  notes       InvestigationNote[]
}

model InvestigationNote {
  id              String        @id @default(uuid())
  investigationId String
  content         String
  authorId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
}

model CaseNote {
  id             String       @id @default(uuid())
  organizationId String
  caseId         String
  authorId       String
  content        String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  author         User         @relation(fields: [authorId], references: [id])
  case           Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, caseId])
  @@index([organizationId, authorId])
}

model Email {
  id                String                       @id @default(uuid())
  messageId         String?
  subject           String?
  senderAddress     String?
  replyTo           String?
  returnPath        String?
  date              DateTime?
  ingestionSrc      String                       @default("UPLOAD")
  rawStorageKey     String?
  classification    EmailClassification          @default(UNKNOWN)
  riskScore         Float?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  organizationId    String
  sha256            String
  analysisStatus    AnalysisState                @default(PENDING)
  caseId            String?
  campaigns         CampaignEmail[]
  dkimVerifications DkimVerification[]
  dmarcVerification DmarcVerification?
  dnsObservations   DnsObservation[]
  case              Case?                        @relation("CaseEmails", fields: [caseId], references: [id])
  organization      Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses         EmailAddress[]
  attachments       EmailAttachment[]
  authAnalysis      EmailAuthenticationAnalysis?
  headers           EmailHeader[]
  urls              EmailUrl[]
  inferences        MLInference[]
  mimeParts         MimePart[]
  relayHops         RelayHop[]
  riskAssessments   RiskAssessment[]
  spfVerifications  SpfVerification[]
  forensicReports   ForensicReport[]
  dispatchEvents    EmailDispatchOutbox[]

  @@unique([id, organizationId])
  @@unique([organizationId, sha256])
  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([messageId])
  @@index([senderAddress])
  @@index([caseId])
}

enum EmailDispatchState {
  PENDING
  DISPATCHING
  DISPATCHED
  COMPLETED
}

model EmailDispatchOutbox {
  id             String             @id @default(uuid())
  organizationId String
  emailId        String
  stage          String
  eventKey       String             @unique
  queueName      String
  jobName        String
  priority       Int?
  payload        Json
  state          EmailDispatchState @default(PENDING)
  attemptCount   Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  claimedAt      DateTime?
  claimToken     String?
  lockedUntil    DateTime?
  dispatchedAt   DateTime?
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          Email              @relation(fields: [emailId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, emailId, stage])
  @@index([state, nextAttemptAt, createdAt])
  @@index([state, updatedAt])
  @@index([organizationId, state, nextAttemptAt])
}

model EmailHeader {
  id        String   @id @default(uuid())
  emailId   String
  name      String
  value     String
  createdAt DateTime @default(now())
  index     Int      @default(0)
  email     Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model RelayHop {
  id               String    @id @default(uuid())
  emailId          String
  hopOrder         Int
  sourceIp         String?
  hostname         String?
  timestamp        DateTime?
  receivedHeader   String
  createdAt        DateTime  @default(now())
  byHost           String?
  fromHost         String?
  parsedConfidence Float?
  protocol         String?
  receivingHost    String?
  sendingHost      String?
  email            Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([createdAt])
}

model EmailAttachment {
  id               String   @id @default(uuid())
  emailId          String
  filename         String
  mimeType         String
  sizeBytes        Int
  sha256           String?
  storageKey       String?
  createdAt        DateTime @default(now())
  actualMimeType   String?
  archiveMetadata  Json?
  isArchive        Boolean  @default(false)
  isMismatch       Boolean  @default(false)
  magicBytes       String?
  // Structured, deterministic findings from AttachmentThreatIndicators —
  // never a fabricated malware verdict, see services/worker's analyzer.
  threatIndicators Json?
  // Populated only when this attachment was identified as an Android APK
  // (via AndroidManifest.xml presence, not filename/extension); see
  // services/worker/src/analyzer/apk/ApkAnalyzer.ts. Null for non-APK files.
  apkMetadata      Json?
  // Populated only when this attachment was identified as an image and QR
  // code(s) were decoded from it; see
  // services/worker/src/analyzer/QrCodeAnalyzer.ts. Null when no QR codes
  // were found or the attachment isn't an image. Decoded QR URLs are
  // additionally persisted as ordinary EmailUrl rows (source QR_CODE) so
  // they flow through the existing URL/CTI/risk-scoring pipeline
  // unchanged — this field is the raw QR-decode record, not a second
  // source of truth for URL analysis.
  qrFindings       Json?
  email            Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([createdAt])
}

model EmailUrl {
  id            String              @id @default(uuid())
  emailId       String
  url           String
  domain        String?
  createdAt     DateTime            @default(now())
  indicators    Json?
  isObfuscated  Boolean             @default(false)
  normalizedUrl String?
  source        UrlExtractionSource @default(TEXT)
  email         Email               @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([createdAt])
}

model MimePart {
  id                 String     @id @default(uuid())
  emailId            String
  parentId           String?
  partIndex          String
  contentType        String
  contentDisposition String?
  filename           String?
  contentId          String?
  contentLocation    String?
  transferEncoding   String?
  charset            String?
  sizeBytes          Int?
  isAttachment       Boolean    @default(false)
  createdAt          DateTime   @default(now())
  email              Email      @relation(fields: [emailId], references: [id], onDelete: Cascade)
  parent             MimePart?  @relation("MimePartHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children           MimePart[] @relation("MimePartHierarchy")

  @@index([emailId])
}

model EmailAddress {
  id          String   @id @default(uuid())
  emailId     String
  headerName  String
  displayName String?
  address     String?
  localPart   String?
  domain      String?
  raw         String
  createdAt   DateTime @default(now())
  email       Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([createdAt])
}

model EmailAuthenticationAnalysis {
  id           String           @id @default(uuid())
  emailId      String           @unique
  spf          AuthResultStatus @default(NONE)
  dkim         AuthResultStatus @default(NONE)
  dmarc        AuthResultStatus @default(NONE)
  isConsistent Boolean          @default(false)
  summary      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  email        Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model SpfVerification {
  id               String           @id @default(uuid())
  emailId          String
  result           AuthResultStatus @default(NONE)
  domain           String?
  evaluatedIp      String?
  matchedMechanism String?
  explanation      String?
  lookups          Int              @default(0)
  createdAt        DateTime         @default(now())
  email            Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model DkimVerification {
  id             String           @id @default(uuid())
  emailId        String
  result         AuthResultStatus @default(NONE)
  domain         String?
  selector       String?
  algorithm      String?
  bodyHashResult AuthResultStatus @default(NONE)
  explanation    String?
  createdAt      DateTime         @default(now())
  email          Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model DmarcVerification {
  id              String           @id @default(uuid())
  emailId         String           @unique
  result          AuthResultStatus @default(NONE)
  orgDomain       String?
  policy          String?
  subdomainPolicy String?
  spfAlignment    String?
  dkimAlignment   String?
  explanation     String?
  createdAt       DateTime         @default(now())
  email           Email            @relation(fields: [emailId], references: [id], onDelete: Cascade)
}

model DnsObservation {
  id         String   @id @default(uuid())
  emailId    String
  queryName  String
  recordType String
  response   String?
  rcode      String?
  durationMs Int?
  createdAt  DateTime @default(now())
  email      Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
}

model Indicator {
  id           String                   @id @default(uuid())
  type         IndicatorType
  value        String                   @unique
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  campaigns    CampaignIndicator[]
  observations ThreatIntelObservation[]

  @@index([type, value])
}

model ThreatIntelObservation {
  id              String        @id @default(uuid())
  indicatorId     String
  provider        String
  verdict         ThreatVerdict
  confidence      Float?
  rawResponse     Json?
  observationTime DateTime      @default(now())
  indicator       Indicator     @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@index([indicatorId])
  @@index([provider])
}

model GeoLocation {
  id        String   @id @default(uuid())
  ipAddress String   @unique
  country   String?
  region    String?
  city      String?
  latitude  Float?
  longitude Float?
  asn       String?
  isp       String?
  provider  String   @default("MaxMind")
  updatedAt DateTime @updatedAt
}

enum RdapLookupStatus {
  SUCCESS
  NOT_FOUND
  PRIVATE_OR_RESERVED
  MALFORMED_DOMAIN
  PROVIDER_TIMEOUT
  PROVIDER_ERROR
  NOT_CONFIGURED
}

// Phase L — RDAP domain intelligence. Keyed by the registrable (public
// suffix + one label) domain, never a full hostname/subdomain — RDAP
// registries only resolve registrable domains, and caching by hostname
// would fragment the cache across every subdomain of the same real
// registration. Global/not tenant-scoped, same rationale as GeoLocation:
// domain registration data is public information, not tenant-specific
// evidence. `status` distinguishes a genuine RDAP result from every
// non-fabricated reason one isn't available — never invented.
model DomainIntelligence {
  id                String           @id @default(uuid())
  registrableDomain String           @unique
  registrar         String?
  registrationDate  DateTime?
  expirationDate    DateTime?
  nameservers       Json?
  domainStatus      Json?
  rdapSource        String?
  status            RdapLookupStatus @default(NOT_CONFIGURED)
  errorMessage      String?
  fetchedAt         DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([status])
}

model MLInference {
  id                   String       @id @default(uuid())
  emailId              String
  prediction           String?
  processingTimeMs     Int?
  explanation          String?
  createdAt            DateTime     @default(now())
  artifactSha256       String?
  labelMappingVersion  String?
  modelName            String?
  modelScore           Float?
  modelVersion         String?
  organizationId       String
  preprocessingVersion String?
  serviceVersion       String?
  status               String       @default("NOT_AVAILABLE")
  tokenizerVersion     String?
  email                Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([emailId])
}

model RiskAssessment {
  id           String       @id @default(uuid())
  emailId      String
  overallScore Float
  riskLevel    Priority
  version      String
  createdAt    DateTime     @default(now())
  email        Email        @relation(fields: [emailId], references: [id], onDelete: Cascade)
  factors      RiskFactor[]

  @@unique([emailId, version])
  @@index([emailId])
}

model RiskFactor {
  id                String         @id @default(uuid())
  riskAssessmentId  String
  category          String
  description       String
  scoreContribution Float
  createdAt         DateTime       @default(now())
  riskAssessment    RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
}

model Campaign {
  id          String              @id @default(uuid())
  name        String
  description String?
  firstSeen   DateTime
  lastSeen    DateTime
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  emails      CampaignEmail[]
  indicators  CampaignIndicator[]
}

model CampaignIndicator {
  campaignId  String
  indicatorId String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  indicator   Indicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@id([campaignId, indicatorId])
}

model CampaignEmail {
  campaignId String
  emailId    String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      Email    @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@id([campaignId, emailId])
}

model Evidence {
  id             String                @id @default(uuid())
  // Denormalized from case.organizationId (same rationale as
  // ForensicReport.organizationId, see its own comment below): lets every
  // query enforce tenant isolation directly on Evidence without requiring a
  // join through Case, and gives the Phase-I evidence model a first-class
  // tenant boundary independent of the case relation.
  organizationId String
  caseId         String
  type           EvidenceType
  storageKey     String
  filename       String?
  mimeType       String?
  sizeBytes      Int?
  sha256         String                @unique
  status         EvidenceStatus        @default(ACTIVE)
  collectionTime DateTime              @default(now())
  collectedById  String?
  // Provenance: which subsystem produced this evidence (e.g.
  // 'MANUAL_UPLOAD', 'EMAIL_INGESTION', 'THREAT_ANALYSIS') — distinct from
  // collectedById (the human actor, when there is one). Null for evidence
  // predating this field.
  sourceSystem   String?
  // Phase M — set exactly once, the moment this evidence is selected into a
  // batch (BlockchainAnchor), and never cleared. This is the idempotency
  // guard against double-anchoring: batch selection is a single UPDATE
  // ... WHERE anchorId IS NULL, so two concurrent workers can never select
  // the same evidence into two different batches.
  anchorId       String?
  anchor         BlockchainAnchor?     @relation(fields: [anchorId], references: [id])
  custodyEvents  ChainOfCustodyEvent[]
  case           Case                  @relation(fields: [caseId], references: [id])

  @@index([caseId])
  @@index([organizationId])
  @@index([anchorId])
}

model ChainOfCustodyEvent {
  id              String               @id @default(uuid())
  evidenceId      String
  action          CustodyAction
  actorId         String?
  description     String?
  previousEventId String?              @unique
  timestamp       DateTime             @default(now())
  // Phase M — SHA256(previousEventHash ?? 'GENESIS' + canonical event
  // fields), computed by services/api/src/utils/custodyChain.ts at write
  // time. Null for events created before this field existed — verification
  // treats those chains as INCOMPLETE (never silently "valid"), never
  // retroactively computed after the fact (that would defeat the point:
  // the hash must be committed at the moment of the event).
  eventHash       String?
  actor           User?                @relation(fields: [actorId], references: [id])
  evidence        Evidence             @relation(fields: [evidenceId], references: [id])
  previous        ChainOfCustodyEvent? @relation("CustodyChain", fields: [previousEventId], references: [id], onDelete: Restrict)
  next            ChainOfCustodyEvent? @relation("CustodyChain")

  @@index([evidenceId])
}

// Phase M — one row per anchored BATCH of evidence (Merkle root over
// multiple evidence hashes), not one row per evidence item — the original
// 1:1-with-Evidence shape was dead schema with zero supporting code (see
// Phase I discovery) and couldn't represent batching at all, so it's
// evolved here rather than duplicated. Tenant-scoped: a batch's Merkle
// tree must never mix evidence from different organizations, unlike
// GeoLocation/DomainIntelligence which are genuinely global public data.
model BlockchainAnchor {
  id             String                 @id @default(uuid())
  organizationId String
  // Idempotency key for this exact batch (see EvidenceBatchingService) —
  // derived from organizationId + the ordered set of evidence hashes +
  // the resulting Merkle root, so retrying/duplicating a job can never
  // create a second anchor for the same batch.
  batchKey       String                 @unique
  merkleRoot     String
  // Ordered evidence IDs — this exact order is what the Merkle tree was
  // built from, and is required to reconstruct/verify it later.
  evidenceIds    Json
  evidenceCount  Int
  hashAlgorithm  String                 @default("SHA-256")
  status         BlockchainAnchorStatus @default(HASHED)
  network        String?
  transactionId  String?
  blockNumber    Int?
  errorDetails   String?
  anchoredAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  evidence       Evidence[]

  @@index([organizationId])
  @@index([status])
}

model Alert {
  id             String        @id @default(uuid())
  organizationId String
  caseId         String?
  title          String
  message        String
  severity       AlertSeverity @default(INFO)
  isRead         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  case           Case?         @relation(fields: [caseId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isRead])
}

model Report {
  id            String   @id @default(uuid())
  caseId        String
  title         String
  contentHtml   String?
  storageKey    String?
  generatedById String?
  createdAt     DateTime @default(now())
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

enum ForensicReportStatus {
  QUEUED
  GENERATING
  COMPLETED
  FAILED
}

// Phase J — deterministic, worker-generated PDF forensic report for a
// single analyzed email. Deliberately a separate model from `Report`
// above: `Report` is case-centric (caseId is required) and a simple
// client-supplied-content CRUD shell; a great many analyzed emails have no
// case at all (Email.caseId is nullable), and report generation here has
// its own async lifecycle (QUEUED/GENERATING/COMPLETED/FAILED, produced by
// a BullMQ worker, not authored by a client). Reusing `Report` would force
// every email report to have a case and would conflate two different
// concerns. organizationId is stored directly (not only reachable via a
// join) so every query can enforce tenant isolation without an extra hop.
model ForensicReport {
  id               String               @id @default(uuid())
  organizationId   String
  emailId          String
  status           ForensicReportStatus @default(QUEUED)
  reportVersion    String               @default("1.0")
  generatedAt      DateTime?
  // Storage key for the generated PDF artifact (same RawEmailStore-shaped
  // abstraction already used for raw emails, under a distinct key prefix —
  // never the raw email content itself).
  artifactLocation String?
  sha256           String?
  errorMessage     String?
  requestedById    String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  email            Email                @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([emailId])
  @@index([organizationId, emailId, status])
}

// Outbound webhook configuration (Phase 2: notification foundation).
// Tenant-owned. `secretEncrypted` uses the same AES-256-GCM envelope format
// as Integration.accessToken/refreshToken (packages/config/src/tokenCrypto.ts)
// — the plaintext secret is only ever returned once, at creation time.
model Webhook {
  id              String            @id @default(uuid())
  organizationId  String
  url             String
  secretEncrypted String
  // Array of WebhookEventType values this webhook is subscribed to, e.g.
  // ["THREAT_ANALYSIS_COMPLETED"]. Stored as Json (not a native Postgres
  // array) to match this schema's existing convention for variable-shape
  // data (see EmailUrl.indicators, EmailAttachment.threatIndicators) and to
  // let new event types be added without a migration.
  events          Json
  enabled         Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@unique([id, organizationId])
  @@index([organizationId])
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  EXHAUSTED
}

// One row per (webhook, event) delivery attempt history. The
// @@unique([webhookId, eventId]) constraint is the durable idempotency
// guarantee: even if the same event is enqueued or processed more than
// once (BullMQ at-least-once delivery, job retry, concurrent workers), a
// second attempt to create this row fails with a unique-constraint error,
// which the delivery worker treats as "already handled" rather than
// sending a duplicate HTTP request.
model WebhookDelivery {
  id             String                @id @default(uuid())
  webhookId      String
  organizationId String
  eventId        String
  eventType      String
  status         WebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                   @default(0)
  lastStatusCode Int?
  lastError      String?
  payload        Json
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  webhook        Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@unique([webhookId, eventId])
  @@index([organizationId])
}

model AuditLog {
  id             String        @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  resource       String
  resourceId     String?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  status         String        @default("SUCCESS")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([createdAt])
  // Org-wide audit log (GET /audit-log) lists by organization ordered by
  // createdAt desc — a composite index lets that be an ordered index scan
  // instead of a bitmap-AND of the two separate single-column indexes above.
  @@index([organizationId, createdAt])
}

model SystemSetting {
  id             String       @id @default(uuid())
  organizationId String
  key            String
  value          String
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model IdempotencyOperation {
  id              String                     @id @default(uuid())
  organizationId  String
  operationKey    String
  operationType   String
  resourceId      String?
  status          IdempotencyOperationStatus @default(PENDING)
  resultReference String?
  errorCode       String?
  errorMessage    String?
  attemptCount    Int                        @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  completedAt     DateTime?

  @@unique([organizationId, operationKey, resourceId])
  @@index([organizationId, operationKey])
}

